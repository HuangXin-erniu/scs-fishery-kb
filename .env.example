# Copy to .env and fill in locally. Never commit .env.

# OpenAI-compatible model endpoint (for example OpenCode Go)
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_REASONING_EFFORT=low
# Request timeout in seconds (default 120); retries are handled by the SDK.
LLM_TIMEOUT=120
# Optional stable session id for provider routing; generated per process when empty.
SCS_FKB_LLM_SESSION=

# Local embedding model
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Maximum source sensitivity allowed to reach the external model
SENSITIVITY_CEILING=public

# Local data root; must be outside the repository.
SCS_FKB_DATA_ROOT=

# Local run artifact root; must be outside the repository.
SCS_FKB_RUN_ROOT=

# Model-written summary for the dump arm (default: model). off restores the
# deterministic summary. The dump arm's answer/refusal decision comes from this
# summary's candidate set, not from a separate retrieval.
SCS_FKB_SUMMARY_MODE=model

# Evidence-sufficiency judge for the extractive and single-pass LLM arms
# (default: off). The dump arm does not use it: its answerability comes from the
# summary judge above.
SCS_FKB_VERIFY_ANSWERS=off

# Optional web-evidence layer (default: off). off|auto|on; the API request field
# overrides this value. auto triggers on freshness cues, stale cited sources or an
# in-scope abstention. SearXNG_URL may point at a local instance; otherwise the
# DuckDuckGo backend is used. SCS_FKB_CA_BUNDLE is an optional explicit CA bundle.
SCS_FKB_WEB=off
SEARXNG_URL=
SCS_FKB_CA_BUNDLE=

# Cross-encoder rerank (default: off). A /v1 request can override per query.
SCS_FKB_RERANK=off

# Answer arm (default: dump). Other arms: extractive, llm, facet, quotes, short.
SCS_FKB_ANSWER_MODE=dump
# Clause-dump window: depth is the retriever depth per query, hits/chars bound
# the quoted evidence. The defaults below are the measured best arm.
SCS_FKB_DUMP_DEPTH=300
SCS_FKB_DUMP_MODE=block
SCS_FKB_DUMP_HITS=300
SCS_FKB_DUMP_CHARS=100000
SCS_FKB_DUMP_NUMBERS=on
# Diagnostic only, rejected in evaluation: question-topic prefix (keep off).
SCS_FKB_DUMP_TOPIC=off

# Local gap queue: when on, the service appends one JSON line per query to
# $SCS_FKB_RUN_ROOT/queries/YYYY-MM-DD.jsonl (question, mode, reason, latency).
# Off by default; the weekly report reads it and never publishes it.
SCS_FKB_LOG_QUERIES=off
