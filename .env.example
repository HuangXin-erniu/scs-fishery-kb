# Copy to .env and fill in locally. Never commit .env.

# OpenAI-compatible model endpoint
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Local embedding model
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Maximum source sensitivity allowed to reach the external model
SENSITIVITY_CEILING=public

# Local data root; must be outside the repository.
SCS_FKB_DATA_ROOT=

# Local run artifact root; must be outside the repository.
SCS_FKB_RUN_ROOT=
