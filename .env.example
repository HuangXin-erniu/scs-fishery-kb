# Copy to .env and fill in locally. Never commit .env.

# OpenAI-compatible model endpoint (for example OpenCode Go)
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_REASONING_EFFORT=low
# Optional stable session id for provider routing; generated per process when empty.
SCS_FKB_LLM_SESSION=

# Local embedding model
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Maximum source sensitivity allowed to reach the external model
SENSITIVITY_CEILING=public

# Local data root; must be outside the repository.
SCS_FKB_DATA_ROOT=

# Local run artifact root; must be outside the repository.
SCS_FKB_RUN_ROOT=
