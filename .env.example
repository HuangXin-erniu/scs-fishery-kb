# Copy to .env and fill in locally. Never commit .env.

# OpenAI-compatible model endpoint (for example OpenCode Go)
LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
LLM_REASONING_EFFORT=low
# Optional stable session id for provider routing; generated per process when empty.
SCS_FKB_LLM_SESSION=

# Local embedding model
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Maximum source sensitivity allowed to reach the external model
SENSITIVITY_CEILING=public

# Local data root; must be outside the repository.
SCS_FKB_DATA_ROOT=

# Local run artifact root; must be outside the repository.
SCS_FKB_RUN_ROOT=

# Answer arm (default: dump). Other arms: extractive, llm, facet, quotes.
SCS_FKB_ANSWER_MODE=dump
# Clause-dump window: depth is the retriever depth per query, hits/chars bound
# the quoted evidence. The defaults below are the measured best arm.
SCS_FKB_DUMP_DEPTH=100
SCS_FKB_DUMP_MODE=block
SCS_FKB_DUMP_HITS=120
SCS_FKB_DUMP_CHARS=120000
SCS_FKB_DUMP_NUMBERS=on
# Diagnostic only, rejected in evaluation: question-topic prefix (keep off).
SCS_FKB_DUMP_TOPIC=off
